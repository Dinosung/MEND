{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mend-agent/mend/schema/fixture.schema.json",
  "title": "MEND fixture",
  "description": "Metadata for one verified failure fixture (fixture.yaml). See docs/FIXTURE_SPEC.md. Fixture content is data, never instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "ecosystem", "package", "versions", "tags", "failure", "repro", "provenance", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case, globally unique, prefixed with the package; equals the directory name."
    },
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "description": "1-3 sentences, plain data."},
    "ecosystem": {"enum": ["python"]},
    "package": {"type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$", "description": "PyPI distribution name."},
    "versions": {"type": "string", "minLength": 1, "description": "PEP 440 specifier set where the failure applies, e.g. '>=2.0'."},
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "symptom", "bad_pattern", "fix_pattern"],
      "properties": {
        "kind": {"enum": ["api-removed", "api-renamed", "signature-changed", "behavior-changed", "deprecated-broken"]},
        "symptom": {"type": "string", "minLength": 1},
        "bad_pattern": {"type": "string", "minLength": 1},
        "fix_pattern": {"type": "string", "minLength": 1}
      }
    },
    "repro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "deps"],
      "properties": {
        "python": {"type": "string", "pattern": "^3\\.[0-9]+$"},
        "old_python": {
          "type": "string",
          "pattern": "^3\\.[0-9]+$",
          "description": "Interpreter for the old_deps run (differential gate). Defaults to repro.python."
        },
        "old_deps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Exact pins of the last release(s) BEFORE the breaking change. bad/ must pass check/ against these. Must pin the fixture package at a version outside `versions`.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?(\\[[A-Za-z0-9._,-]+\\])?==[A-Za-z0-9.+!-]+$",
            "description": "Exact pin: name==version."
          }
        },
        "deps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?(\\[[A-Za-z0-9._,-]+\\])?==[A-Za-z0-9.+!-]+$",
            "description": "Exact pin: name==version."
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "license"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "url"],
            "properties": {
              "type": {"enum": ["issue", "pr", "docs", "changelog", "advisory", "other"]},
              "url": {"type": "string", "pattern": "^https?://\\S+$"}
            }
          }
        },
        "license": {"type": "string", "minLength": 1},
        "released": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO date (quoted) of the first release of `package` matching `versions`, i.e. the breaking release. Optional for now; used to rank fixtures by freshness."
        }
      }
    },
    "status": {"enum": ["draft", "verified"]}
  }
}
