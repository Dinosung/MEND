  "author": {
    "name": "Dinosung",
    "url": "https://github.com/Dinosung"
  },
  "homepage": "https://github.com/Dinosung/MEND",
  "repository": "https://github.com/Dinosung/MEND",
  "license": "MIT",
  "keywords": ["python", "dependencies", "migration", "lint", "hooks", "mcp"],
  "hooks": "./plugin/hooks.json",
  "mcpServers": {
    "mend": {
      "command": "sh",
      "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/run-mend.sh", "serve"]
    }
  }
}
